# === Node A(GPU ノード)の vLLM ===
VLLM_BASE_URL=http://node-a.example.internal:8080/v1
# Node A の --api-key と同じ値にする
VLLM_API_KEY=change-me

# === Open WebUI ===
# 生成例: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# === Open WebUI 内蔵 RAG(Node B の CPU で実行)===
# bge-m3 は query:/passage: プレフィックス不要。e5 系は自動付与されないため既定では使わない
RAG_EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_RAG_HYBRID_SEARCH=true
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=5
