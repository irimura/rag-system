# === Node A(GPU ノード)の vLLM ===
VLLM_BASE_URL=http://node-a.example.internal:8080/v1
VLLM_API_KEY=change-me

# === Open WebUI ===
# 生成例: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me
ENABLE_LOGIN_FORM=true

# === Open WebUI 内蔵 RAG(Node B の CPU で実行)===
RAG_EMBEDDING_MODEL=BAAI/bge-m3
ENABLE_RAG_HYBRID_SEARCH=true
RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RAG_TOP_K=5

# === OIDC(任意。空のままならローカル認証だけで動作)===
# OAuth 系は PersistentConfig のため、初回起動前に設定するか Admin UI で更新する
ENABLE_OAUTH_SIGNUP=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=
OAUTH_PROVIDER_NAME=
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=
ENABLE_OAUTH_GROUP_MANAGEMENT=
ENABLE_OAUTH_GROUP_CREATION=
OAUTH_GROUP_CLAIM=

# === 検証用 Keycloak(profile: idp)===
KEYCLOAK_ADMIN_USERNAME=admin
# 生成例: openssl rand -hex 32
KEYCLOAK_ADMIN_PASSWORD=change-me
