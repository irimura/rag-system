# === Node A ===
VLLM_BASE_URL=http://node-a.example.internal:8080/v1
VLLM_MODEL=your-hf-model-name
VLLM_API_KEY=change-me
RAG_MODEL_NAME=knowledge-rag

# === Embedding / Rerank ===
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TEI_EMBED_URL=http://tei-embed:80
TEI_RERANK_URL=http://tei-rerank:80

# === OpenSearch ===
OPENSEARCH_URL=https://node-0.example.com:9200
OS_CA_CERT=/app/certs/root-ca.pem
OS_INDEX=knowledge
OS_HEAP=4g

# === RAG ===
RETRIEVE_K=20
SEARCH_K=30
RERANK_TOP_N=5
RERANK_THRESHOLD=0.1
MAX_RETRIES=2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DOCS_DIR=/data/documents

# === セキュリティ(各値を別々に openssl rand -hex 32 で生成)===
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-admin
OS_RAG_PASSWORD=change-me-rag
OS_INGEST_PASSWORD=change-me-ingest
OS_GROUP_USER_SECRET=change-me
WEBUI_SECRET_KEY=change-me
FORWARD_USER_INFO_HEADER_JWT_SECRET=change-me
EVAL_TOKEN=change-me
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
ENABLE_LOGIN_FORM=true

# === OIDC(任意。空のままならローカル認証だけで動作)===
# OAuth 系は PersistentConfig のため初回起動前に設定するか Admin UI で更新する
# ENABLE_OAUTH_SIGNUP=true
# OAUTH_CLIENT_ID=open-webui
# OAUTH_CLIENT_SECRET=open-webui-local-verification-secret
# OPENID_PROVIDER_URL=http://keycloak:8080/realms/rag/.well-known/openid-configuration
# OAUTH_PROVIDER_NAME=Keycloak
# OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
# ENABLE_OAUTH_GROUP_MANAGEMENT=true
# ENABLE_OAUTH_GROUP_CREATION=true
# OAUTH_GROUP_CLAIM=groups
