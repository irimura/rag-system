# Node B 上のコーパス保存先。リポジトリ外を推奨する。
CORPUS_DIR="${HOME}/rag-corpus"

# e-Gov 法令 API Version 1。法令 ID は空白区切りで差し替えられる。
EGOV_API_BASE="https://laws.e-gov.go.jp/api/1/lawdata"
EGOV_LAW_IDS="415AC0000000057 322AC0000000049 129AC0000000089 417AC0000000086 345AC0000000048 405AC0000000047 405AC0000000088 419AC0000000128 411AC0000000042 426AC1000000104"

# 総務省 情報通信白書。年度ごとに PDF URL の構成が変わるため、公式ページで確認して設定する。
WHITEPAPER_YEAR="2025"
SOUMU_WHITEPAPER_URL=""
SOUMU_WHITEPAPER_FILENAME=""
SOUMU_WHITEPAPER_PAGE_URL="https://www.soumu.go.jp/johotsusintokei/whitepaper/"

# IPA の取得対象。空白区切り。既定は情報セキュリティ白書 2025 と中小企業向けガイドライン第 4.0 版。
IPA_PDF_URLS="https://www.ipa.go.jp/publish/wp-security/j5u9nn0000004wk0-att/ISWP2025_ALL.pdf https://www.ipa.go.jp/security/guide/sme/ug65p90000019cbk-att/sme_guideline_v4.0.pdf"
IPA_SOURCE_PAGE_URLS="https://www.ipa.go.jp/publish/wp-security/2025.html https://www.ipa.go.jp/security/guide/sme/index.html"

# livedoor ニュースコーパス(CC BY-ND 2.1 JP、改変禁止・社内評価限定)。
LIVEDOOR_URL="https://www.rondhuit.com/download/ldcc-20140209.tar.gz"

# Wikipedia 日本語版ダンプ。日付は latest または YYYYMMDD。
WIKIPEDIA_DUMP_DATE="latest"
WIKIPEDIA_MODE="partial"
# partial の自動検出に失敗した場合だけ、先頭分割ファイルの公式 URL を設定する。
WIKIPEDIA_PARTIAL_URL=""
WIKIPEDIA_MAX_ARTICLES="10000"
# カンマ区切り。空ならカテゴリで絞り込まない。例: 情報技術,コンピュータ
WIKIPEDIA_CATEGORIES=""
WIKIEXTRACTOR_PROCESSES="4"
