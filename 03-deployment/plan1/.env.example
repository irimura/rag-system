# === Node A(GPU ノード)の vLLM ===
VLLM_BASE_URL=http://node-a.example.internal:8080/v1
# Node A の SERVED_MODEL_NAME と一致させる(deploy/node-a/.env.example の SERVED_MODEL_NAME)
VLLM_MODEL=your-hf-model-name
# Node A の --api-key と同じ値にする
VLLM_API_KEY=change-me

# === Embedding / Rerank(Node B の CPU で実行)===
# e5 系は query:/passage: プレフィックスを common.py が自動付与する
EMBED_MODEL=intfloat/multilingual-e5-large
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# === RAG パラメータ ===
RETRIEVE_K=20
RERANK_TOP_N=4
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# === パス(コンテナ内。通常変更不要)===
DOCS_DIR=/data/documents
CHROMA_DIR=/data/chroma_db
