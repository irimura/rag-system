# === モデル配置 ===
# ホスト上のモデル格納ディレクトリ(コンテナには /models としてマウントされる)
MODELS_DIR=/opt/models
# コンテナ内から見たモデルパス(HF 形式のディレクトリ)
MODEL_PATH=/models/your-hf-model
# API 上で公開するモデル名(Node B 各案の .env の VLLM_MODEL と一致させる)
SERVED_MODEL_NAME=your-hf-model-name

# === GPU / メモリ ===
GPU_MEMORY_UTILIZATION=0.90   # VRAM の確保割合
MAX_MODEL_LEN=8192            # Node A のモデル要件は最大32k。8192は初期運用値であり上限ではない(OOM時は下げる)
TENSOR_PARALLEL_SIZE=1        # GPU 複数枚で分割する場合は枚数を指定

# === 認証(必ず変更。Node B 各案の .env の VLLM_API_KEY と同じ値にする)===
# 生成例: openssl rand -hex 32
VLLM_API_KEY=change-me
