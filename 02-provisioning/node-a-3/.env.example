# Node A-3 用。docker-compose.yml / vllm.service は ../node-a/ の共通ファイルを使用する
# === モデル配置 ===
MODELS_DIR=/opt/models
MODEL_PATH=/models/your-16bit-hf-model
SERVED_MODEL_NAME=your-16bit-model-name

# === GPU / メモリ ===
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=32768
# 単一 A100/H100 80GB 案は 1。2×L40S 案を採用した場合のみ 2
TENSOR_PARALLEL_SIZE=1

# === 認証(必ず変更。Node B 各案の .env の VLLM_API_KEY と同じ値にする)===
# 生成例: openssl rand -hex 32
VLLM_API_KEY=change-me
