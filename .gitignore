# macOS
.DS_Store

# 環境変数(接続先・秘密情報)— .env.example を元に各自作成する
deploy/**/.env

# 投入文書(ユーザーデータ)
deploy/**/documents/*
!deploy/**/documents/.gitkeep

# TLS 証明書・秘密鍵
deploy/plan1b/nginx/certs/*
!deploy/plan1b/nginx/certs/.gitkeep
deploy/plan2/nginx/certs/*
!deploy/plan2/nginx/certs/.gitkeep
deploy/plan3/nginx/certs/*
!deploy/plan3/nginx/certs/.gitkeep
deploy/plan3/rag-api/certs/root-ca.pem

# Python
__pycache__/
*.pyc
.venv/
.venv-corpus/
.venv-allganize/
04-corpus/allganize-ja/
